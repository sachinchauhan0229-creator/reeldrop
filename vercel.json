{
  "outputDirectory": "public",
  "functions": {
    "api/download.js": {
      "maxDuration": 60
    },
    "api/direct.py": {
      "maxDuration": 60
    },
    "api/save.py": {
      "maxDuration": 60
    },
    "api/mcp.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "reeldrop-five.vercel.app"
        }
      ],
      "destination": "https://reeldrop.jobcraft.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "reeldrop-sachin.vercel.app"
        }
      ],
      "destination": "https://reeldrop.jobcraft.in/:path*",
      "permanent": true
    }
  ]
}
